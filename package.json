{
  "name": "shelfkeep",
  "version": "0.1.0",
  "description": "A lightweight personal inventory and asset manager built with TypeScript, Node.js, and SQLite.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "inventory",
    "asset-management",
    "self-hosted",
    "sqlite",
    "typescript"
  ],
  "author": "Willian de Souza",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
